---
import { u } from '../lib/sitio';
interface Props { items: { texto: string; href?: string }[] }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ texto: 'Inicio', href: '/' }, ...items].map((i, n) => ({
    '@type': 'ListItem',
    position: n + 1,
    name: i.texto,
    ...(i.href ? { item: new URL(u(i.href), Astro.site).href } : {}),
  })),
};
---

<nav class="miga" aria-label="Ruta de navegación">
  <ol>
    <li><a href={u('/')}>Inicio</a></li>
    {items.map((i) => (
      <li>{i.href ? <a href={u(i.href)}>{i.texto}</a> : <span aria-current="page">{i.texto}</span>}</li>
    ))}
  </ol>
</nav>
<script set:html={JSON.stringify(schema)} type="application/ld+json" is:inline />

<style>
  .miga { font-size: 0.82rem; color: var(--muted); }
  .miga ol { display: flex; flex-wrap: wrap; gap: 0.3rem 0.55rem; list-style: none; margin: 0; padding: 0; }
  .miga li + li::before { content: '/'; margin-right: 0.55rem; color: var(--faint); }
  .miga a { color: var(--muted); text-decoration: none; }
  .miga a:hover { color: var(--vino-ink); text-decoration: underline; }
  .miga [aria-current] { color: var(--ink-2); }
</style>
