---
import Base from '../../layouts/Base.astro';
import Encabezado from '../../components/Encabezado.astro';
import Miga from '../../components/Miga.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import { publicadas, porGrupo } from '../../lib/colecciones';

const entradas = await publicadas('historia');
const grupos = porGrupo(entradas);
const agrupar = true && grupos.length > 1;
---

<Base titulo="Lola Mora" descripcion="La escultora argentina que dio nombre a la marca: su biografía, sus obras y las distintas fuentes sobre su origen.">
  <div class="contenedor seccion">
    <Miga items={[{ texto: 'Lola Mora' }]} />
    <Encabezado antetitulo="Historia" titulo="Lola Mora" bajada="La escultora argentina que dio nombre a la marca: su biografía, sus obras y las distintas fuentes sobre su origen." />

    <aside class="aclaracion">
      <strong>Nota histórica:</strong> las fuentes públicas no coinciden sobre la fecha y el
      lugar exactos de su nacimiento. El archivo de la marca desarrolla la versión de El Tala,
      Salta; otras fuentes la sitúan en Tucumán. Los artículos se presentan como documentación
      histórica y no como una controversia definitivamente resuelta.
    </aside>

    {agrupar ? grupos.map(([grupo, items]) => (
      <section class="grupo">
        <h2 class="grupo__titulo">{grupo}</h2>
        <div class="grilla">
          {items.map((e) => (
            <Tarjeta
              href={`/lola-mora/${e.id}/`}
              titulo={e.data.titulo}
              descripcion={e.data.descripcion}
              imagen={e.data.portada}
              pie="Leer"
            />
          ))}
        </div>
      </section>
    )) : (
      <div class="grilla">
        {entradas.map((e) => (
          <Tarjeta
            href={`/lola-mora/${e.id}/`}
            titulo={e.data.titulo}
            descripcion={e.data.descripcion}
            imagen={e.data.portada}
            etiqueta={e.data.grupo}
            pie="Leer"
          />
        ))}
      </div>
    )}
  </div>
</Base>

<style>
  .aclaracion {
    margin-bottom: 2rem;
    padding: 1rem 1.2rem;
    color: var(--ink-2);
    background: var(--oro-wash);
    border: 1px solid var(--line-2);
    border-radius: var(--radio);
  }
  .grupo + .grupo { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .grupo__titulo {
    font-size: 1.32rem;
    margin-bottom: 1.2rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
  }
</style>
