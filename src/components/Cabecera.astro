---
import { sitio, u } from '../lib/sitio';

const actual = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const esActual = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
---

<header class="cab">
  <div class="contenedor cab__fila">
    <a class="marca" href={u('/')} aria-label={`${sitio.nombre} — inicio`}>
      <span class="marca__nombre">Lola Mora</span>
      <span class="marca__sub">Wine</span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav__lista">
        {sitio.navegacion.map((i) => (
          <li>
            <a href={u(i.href)} aria-current={esActual(i.href) ? 'page' : undefined}>{i.texto}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="cab__acciones">
      <a class="boton boton--linea cab__cta" href={u('/contacto/')}>Contacto</a>
      <button id="tema" class="icono" type="button" aria-label="Cambiar entre tema claro y oscuro">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button id="abrir-menu" class="icono icono--movil" type="button" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="menu-movil" class="movil" aria-label="Navegación móvil" hidden>
    <ul>
      {sitio.navegacion.map((i) => (
        <li><a href={u(i.href)} aria-current={esActual(i.href) ? 'page' : undefined}>{i.texto}</a></li>
      ))}
      <li><a href={u('/noticias/')}>Noticias</a></li>
      <li><a href={u('/nosotros/')}>Nosotros</a></li>
      <li><a href={u('/contacto/')}>Contacto</a></li>
    </ul>
  </nav>
</header>

<style>
  .cab {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .cab__fila {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 66px;
  }

  .marca {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }
  .marca__nombre {
    font-family: Petrona, Georgia, serif;
    font-size: 1.32rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .marca__sub {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--vino);
  }

  .nav { margin-left: auto; }
  .nav__lista {
    display: flex;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__lista a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    padding-block: 0.45rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .nav__lista a:hover { color: var(--vino-ink); }
  .nav__lista a[aria-current='page'] { color: var(--vino-ink); border-bottom-color: var(--vino); }

  .cab__acciones { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
  .nav + .cab__acciones { margin-left: 0; }

  .cab__cta { padding: 0.5rem 1rem; font-size: 0.88rem; }

  .icono {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: var(--radio);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .icono:hover { background: var(--surface-2); color: var(--vino-ink); }
  .icono--movil { display: none; }

  .movil { border-top: 1px solid var(--line); background: var(--surface); }
  .movil ul { list-style: none; margin: 0; padding: 0.5rem clamp(1rem, 4vw, 2.5rem) 1rem; }
  .movil li + li { border-top: 1px solid var(--line-soft); }
  .movil a {
    display: block;
    padding: 0.8rem 0;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .movil a[aria-current='page'] { color: var(--vino-ink); }

  @media (max-width: 1000px) {
    .nav { display: none; }
    .icono--movil { display: grid; }
    .cab__cta { display: none; }
  }
</style>

<script>
  // Tema claro / oscuro, recordado en el navegador de cada visitante.
  const btn = document.getElementById('tema');
  btn?.addEventListener('click', () => {
    const raiz = document.documentElement;
    const oscuroAhora =
      raiz.dataset.theme === 'dark' ||
      (!raiz.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const nuevo = oscuroAhora ? 'light' : 'dark';
    raiz.dataset.theme = nuevo;
    try { localStorage.setItem('lm-tema', nuevo); } catch { /* sin almacenamiento */ }
  });

  // Menú móvil
  const abrir = document.getElementById('abrir-menu');
  const menu = document.getElementById('menu-movil');
  abrir?.addEventListener('click', () => {
    const abierto = abrir.getAttribute('aria-expanded') === 'true';
    abrir.setAttribute('aria-expanded', String(!abierto));
    abrir.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
    if (menu) menu.hidden = abierto;
  });
</script>
