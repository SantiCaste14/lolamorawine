---
/**
 * Identidad heráldica simplificada de Lola Mora Wine.
 * El trazado de un solo color toma como referencia la variante lineal elegida por
 * el propietario y evita texturas, degradados e imágenes raster que pierdan nitidez.
 */
interface Props {
  /** Alto en píxeles. El ancho se deduce de la proporción. */
  alto?: number;
  /** Oculta la cinta inferior para la barra de navegación. */
  compacto?: boolean;
  class?: string;
}
const { alto = 64, compacto = false, class: clase = '' } = Astro.props;
const ancho = Math.round(alto * (compacto ? 0.84 : 0.82));
---

<svg
  class={clase}
  width={ancho}
  height={alto}
  viewBox={compacto ? '0 0 200 242' : '0 0 200 250'}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Lola Mora Wine — Arte y Vino"
>
  <!-- Corona abierta: líneas amplias y margen de seguridad para que nunca se recorte. -->
  <path d="M30 53 22 18 68 42 100 8l32 34 46-24-8 35Z"
        fill="#6e121b" stroke="#d6aa4a" stroke-width="5" stroke-linejoin="round" />
  <path d="M37 53h126" stroke="#d6aa4a" stroke-width="5" stroke-linecap="round" />
  <rect x="49" y="36" width="8" height="8" fill="#d6aa4a" />
  <rect x="96" y="27" width="8" height="8" fill="#d6aa4a" />
  <rect x="143" y="36" width="8" height="8" fill="#d6aa4a" />

  <!-- Escudo contemporáneo. -->
  <path d="M18 58h164v104c0 22-13 38-31 49-15 10-33 18-51 29-18-11-36-19-51-29-18-11-31-27-31-49Z"
        fill="#6e121b" stroke="#d6aa4a" stroke-width="5" stroke-linejoin="round" />
  <rect x="18" y="58" width="164" height="34" fill="#6e121b" stroke="#d6aa4a" stroke-width="4" />
  <text x="100" y="81" text-anchor="middle" font-family="Cinzel, Georgia, serif"
        font-size="17" font-weight="600" letter-spacing="2.8" fill="#f0cc78">LOLA MORA</text>

  <!-- Cuatro campos: iniciales, escultura y vino. -->
  <path d="M100 92v126M20 145h160" stroke="#d6aa4a" stroke-width="3" />
  <text x="59" y="137" text-anchor="middle" font-family="Cinzel, Georgia, serif"
        font-size="47" font-weight="500" fill="#f0cc78">L</text>
  <text x="142" y="198" text-anchor="middle" font-family="Cinzel, Georgia, serif"
        font-size="47" font-weight="500" fill="#f0cc78">M</text>

  <!-- Caballo escultórico, reducido a una silueta legible a tamaños pequeños. -->
  <path d="M122 131c4-10 10-17 19-21 1-7 5-12 11-15l-1 12c8 3 13 9 14 17-5-2-10-2-15 0-4 2-6 6-9 10-7 5-14 6-21 3l8-7c-3 0-5 0-6 1Z"
        fill="#d6aa4a" />
  <path d="M137 113c4 4 8 6 14 7" stroke="#6e121b" stroke-width="2.5" stroke-linecap="round" />

  <!-- Racimo minimalista. -->
  <path d="M57 155c2-7 7-11 14-13" stroke="#d6aa4a" stroke-width="3" stroke-linecap="round" />
  <g fill="#d6aa4a">
    <circle cx="48" cy="164" r="6"/><circle cx="61" cy="164" r="6"/><circle cx="74" cy="164" r="6"/>
    <circle cx="54" cy="177" r="6"/><circle cx="67" cy="177" r="6"/>
    <circle cx="60.5" cy="190" r="6"/><circle cx="60.5" cy="203" r="6"/>
  </g>

  {!compacto && (
    <>
      <!-- Cinta de cierre, contenida por completo dentro del viewBox. -->
      <path d="M8 204c25 14 55 20 92 20s67-6 92-20l-9 28c-23 10-51 15-83 15s-60-5-83-15Z"
            fill="#6e121b" stroke="#d6aa4a" stroke-width="4" stroke-linejoin="round" />
      <text x="100" y="237" text-anchor="middle" font-family="Cinzel, Georgia, serif"
            font-size="11" font-weight="600" letter-spacing="2.2" fill="#f0cc78">ARTE Y VINO</text>
    </>
  )}
</svg>
