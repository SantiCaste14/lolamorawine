---
// Verificación preventiva de edad para un sitio que promociona alcohol.
// Ayuda a cumplir la prohibición de venta a menores, pero no sustituye la
// verificación comercial que corresponda al confirmar una operación.
// Se pinta oculto y sólo el script lo muestra, para que nunca bloquee a los buscadores
// ni a quien navegue sin JavaScript.
import { sitio } from '../lib/sitio';
---

<div id="control-edad" class="edad" hidden>
  <div class="edad__caja" role="dialog" aria-modal="true" aria-labelledby="edad-titulo" aria-describedby="edad-descripcion">
    <p class="edad__marca">Lola Mora <span>Wine</span></p>
    <h2 id="edad-titulo">¿Sos mayor de 18 años?</h2>
    <p id="edad-descripcion" class="edad__texto">
      Este sitio contiene información sobre bebidas alcohólicas.
      Para ingresar tenés que ser mayor de edad.
    </p>
    <div class="edad__acciones">
      <button id="edad-si" class="boton" type="button">Sí, soy mayor de 18</button>
      <a class="boton boton--suave" href="https://www.argentina.gob.ar/salud" rel="noopener">No</a>
    </div>
    <p class="edad__legal">{sitio.leyendaAlcohol}</p>
  </div>
</div>

<style>
  .edad {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--ground) 88%, #000);
    backdrop-filter: blur(6px);
  }
  .edad[hidden] { display: none; }

  .edad__caja {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: var(--sombra-alta);
    padding: clamp(1.6rem, 5vw, 2.5rem);
    max-width: 30rem;
    text-align: center;
  }
  .edad__marca {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 1.2rem;
  }
  .edad__marca span {
    font-family: Archivo, sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--vino);
  }
  .edad__texto { color: var(--muted); margin-top: 0.7rem; font-size: 0.95rem; }
  .edad__acciones {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.6rem;
  }
  .edad__legal {
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.75rem;
    color: var(--faint);
  }
</style>

<script>
  const CLAVE = 'lm-edad-ok';
  const caja = document.getElementById('control-edad');
  let yaPaso = false;
  try { yaPaso = localStorage.getItem(CLAVE) === '1'; } catch { yaPaso = false; }

  if (!yaPaso && caja) {
    const fondo = [...document.body.children].filter(
      (elemento): elemento is HTMLElement => elemento !== caja && elemento instanceof HTMLElement
    );
    const focoAnterior = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const interactivos = (): HTMLElement[] => [...caja.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')]
      .filter((elemento): elemento is HTMLElement => elemento instanceof HTMLElement && !elemento.hidden);

    caja.hidden = false;
    fondo.forEach((elemento) => { elemento.inert = true; });
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => document.getElementById('edad-si')?.focus());

    caja.addEventListener('keydown', (evento) => {
      if (evento.key !== 'Tab') return;
      const elementos = interactivos();
      const primero = elementos[0];
      const ultimo = elementos.at(-1);
      if (!primero || !ultimo) return;
      if (evento.shiftKey && document.activeElement === primero) {
        evento.preventDefault();
        ultimo.focus();
      } else if (!evento.shiftKey && document.activeElement === ultimo) {
        evento.preventDefault();
        primero.focus();
      }
    });

    document.getElementById('edad-si')?.addEventListener('click', () => {
      try { localStorage.setItem(CLAVE, '1'); } catch { /* sin almacenamiento */ }
      caja.hidden = true;
      fondo.forEach((elemento) => { elemento.inert = false; });
      document.body.style.overflow = '';
      (focoAnterior && focoAnterior !== document.body
        ? focoAnterior
        : document.querySelector<HTMLElement>('.marca'))?.focus();
    });
  }
</script>
