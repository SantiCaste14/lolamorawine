---
import Escudo from './Escudo.astro';
import { sitio, u } from '../lib/sitio';
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor pie__grilla">
    <div class="pie__marca">
      <Escudo alto={82} />
      <p class="pie__nombre">Lola Mora <span>Wine</span></p>
      <p class="pie__lema">{sitio.lema}.<br />{sitio.bajada}.</p>
      {sitio.contacto.email && (
        <p class="pie__dato"><a href={`mailto:${sitio.contacto.email}`}>{sitio.contacto.email}</a></p>
      )}
      {sitio.contacto.telefono && <p class="pie__dato">{sitio.contacto.telefono}</p>}
    </div>

    {sitio.pie.map((col) => (
      <nav class="pie__col" aria-label={col.titulo}>
        <h2 class="pie__titulo">{col.titulo}</h2>
        <ul>
          {col.enlaces.map((e) => <li><a href={u(e.href)}>{e.texto}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>

  <div class="contenedor pie__legal">
    <p class="pie__alcohol">{sitio.leyendaAlcohol}</p>
    <div class="pie__fila">
      <p>
        &copy; {anio} {sitio.nombre}
        {sitio.empresa.razonSocial ? ` — ${sitio.empresa.razonSocial}` : ''}
        {sitio.empresa.cuit ? ` — CUIT ${sitio.empresa.cuit}` : ''}
      </p>
      <p class="pie__enlaces">
        <a href={u('/boton-de-arrepentimiento/')}>Botón de arrepentimiento</a>
        <span aria-hidden="true">·</span>
        <a href={u('/creditos/')}>Créditos de imágenes</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .pie {
    margin-top: auto;
    position: relative;
    background: var(--ground-2);
    border-top: 1px solid var(--line);
    padding-top: clamp(3rem, 7vw, 5rem);
  }
  .pie::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(to right, transparent, var(--oro) 35%, var(--vino) 65%, transparent);
    opacity: .6;
  }

  .pie__grilla {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    grid-template-columns: 1fr;
    padding-bottom: 3rem;
  }
  @media (min-width: 640px) {
    .pie__grilla { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .pie__grilla { grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr)); }
  }

  .pie__marca { display: grid; justify-items: start; gap: .5rem; }
  .pie__nombre {
    margin-top: .6rem;
    font-family: var(--romana);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: .03em;
  }
  .pie__nombre span {
    font-size: .58rem;
    letter-spacing: .45em;
    text-transform: uppercase;
    color: var(--oro);
    vertical-align: middle;
  }
  .pie__lema { color: var(--muted); font-size: .9rem; line-height: 1.6; }
  .pie__dato { font-size: .9rem; margin-top: .4rem; }

  .pie__titulo {
    font-family: var(--romana);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--oro);
    margin-bottom: 1rem;
  }
  .pie__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .pie__col a { color: var(--ink-2); text-decoration: none; font-size: .9rem; }
  .pie__col a:hover { color: var(--oro-claro); }

  .pie__legal { border-top: 1px solid var(--line); padding-block: 1.6rem 2.4rem; }
  .pie__alcohol {
    font-family: var(--romana);
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--oro);
    text-align: center;
    padding: .75rem 1rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radio);
    margin-bottom: 1.3rem;
  }
  .pie__fila {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem 1.5rem;
    justify-content: space-between;
    font-size: .8rem;
    color: var(--muted);
  }
  .pie__enlaces { display: flex; gap: .6rem; flex-wrap: wrap; }
  .pie__fila a { color: var(--muted); }
  .pie__fila a:hover { color: var(--oro-claro); }
</style>
