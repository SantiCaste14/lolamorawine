---
import Base from './Base.astro';
import Miga from '../components/Miga.astro';
import { u } from '../lib/sitio';

interface Props {
  titulo: string;
  descripcion: string;
  portada?: string;
  grupo?: string;
  fecha?: Date;
  miga: { texto: string; href?: string }[];
  /** Enlaces al artículo anterior y siguiente de la misma sección. */
  anterior?: { titulo: string; href: string } | null;
  siguiente?: { titulo: string; href: string } | null;
}

const { titulo, descripcion, portada, grupo, fecha, miga, anterior = null, siguiente = null } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: descripcion,
  inLanguage: 'es-AR',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  ...(portada ? { image: new URL(u(portada), Astro.site).href } : {}),
  ...(fecha ? { datePublished: fecha.toISOString() } : {}),
  publisher: { '@type': 'Organization', name: 'Lola Mora Wine' },
};

const fechaLegible = fecha
  ? new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric' }).format(fecha)
  : null;
---

<Base titulo={titulo} descripcion={descripcion} imagen={portada} tipo="article" schema={schema}>
  <article class="art">
    <div class="contenedor art__cab">
      <Miga items={miga} />
      {grupo && <p class="antetitulo art__grupo">{grupo}</p>}
      <h1>{titulo}</h1>
      <div class="filete"></div>
      <p class="art__bajada">{descripcion}</p>
      {fechaLegible && <p class="art__fecha"><time datetime={fecha!.toISOString()}>{fechaLegible}</time></p>}
    </div>

    {portada && (
      <div class="contenedor art__portada">
        <img src={u(portada)} alt={titulo} width="1100" height="620" loading="eager" decoding="async" />
      </div>
    )}

    <div class="contenedor-lectura">
      <div class="prosa">
        <slot />
      </div>

      {(anterior || siguiente) && (
        <nav class="art__nav" aria-label="Más de esta sección">
          {anterior ? (
            <a class="art__nav-item" href={u(anterior.href)}>
              <span>Anterior</span>
              <strong>{anterior.titulo}</strong>
            </a>
          ) : <span></span>}
          {siguiente && (
            <a class="art__nav-item art__nav-item--der" href={u(siguiente.href)}>
              <span>Siguiente</span>
              <strong>{siguiente.titulo}</strong>
            </a>
          )}
        </nav>
      )}
    </div>
  </article>
</Base>

<style>
  .art { padding-block: clamp(1.75rem, 4vw, 3rem) clamp(3rem, 7vw, 5rem); }
  .art__cab { display: flex; flex-direction: column; gap: 0.85rem; max-width: 62rem; }
  .art__grupo { margin-top: 0.4rem; }
  .art__bajada { font-size: clamp(1.02rem, 2vw, 1.18rem); color: var(--muted); max-width: 60ch; }
  .art__fecha { font-size: 0.85rem; color: var(--faint); }

  .art__portada { margin-block: clamp(1.75rem, 4vw, 2.75rem); }
  .art__portada img {
    width: 100%;
    max-height: 30rem;
    object-fit: cover;
    border-radius: var(--radio);
    border: 1px solid var(--line);
  }

  .art__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .art__nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radio);
    text-decoration: none;
    color: var(--ink);
    background: var(--surface);
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .art__nav-item:hover { border-color: var(--vino); background: var(--vino-wash); color: var(--ink); }
  .art__nav-item--der { text-align: right; }
  .art__nav-item span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .art__nav-item strong { font-size: 0.95rem; font-weight: 600; line-height: 1.3; }

  @media (max-width: 640px) {
    .art__nav { grid-template-columns: 1fr; }
    .art__nav-item--der { text-align: left; }
  }
</style>
