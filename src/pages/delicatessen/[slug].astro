---
import { render } from 'astro:content';
import Articulo from '../../layouts/Articulo.astro';
import { publicadas, vecinos } from '../../lib/colecciones';

export async function getStaticPaths() {
  const entradas = await publicadas('delicatessen');
  return entradas.map((e) => ({ params: { slug: e.id }, props: { e, entradas } }));
}

const { e, entradas } = Astro.props;
const { Content } = await render(e);
const { anterior, siguiente } = vecinos(entradas, e.id, '/delicatessen');
---

<Articulo
  titulo={e.data.titulo}
  descripcion={e.data.descripcion}
  portada={e.data.portada}
  grupo={e.data.grupo}
  miga={[{ texto: 'Delicatessen', href: '/delicatessen/' }, { texto: e.data.titulo }]}
  anterior={anterior}
  siguiente={siguiente}
>
  <Content />
</Articulo>
